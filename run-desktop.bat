@echo off
chcp 65001 >nul
title تشغيل برنامج الاستلامات للفروع كبرنامج ديسكتوب
cls
echo ==============================================================================
echo        🦅 صقر الشرق - برنامج الاستلامات للفروع والمخازن
echo         تشغيل البرنامج في نافذة مستقلة Desktop App
echo ==============================================================================
echo.
echo جاري فحص ملفات البناء...
if not exist "dist\index.html" (
    echo جاري بناء ملفات الإنتاج لأول مرة...
    call npm run build
)

echo جاري فتح البرنامج كنافذة ديسكتوب...
call npx electron electron/main.cjs
if %errorlevel% neq 0 (
    echo فتح البرنامج عبر المتصفح المحلي الافتراضي...
    start "" "dist\index.html"
)
